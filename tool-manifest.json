{
  "name": "speaker-transcribe",
  "description": "Speaker-attributed transcription from local media files or YouTube URLs",
  "version": "0.1.0",
  "skill_repository": "https://github.com/xplrr/skill-speaker-transcribe",
  "tool_repository": "https://github.com/xplrr/speaker-transcribe",
  "launchers": {
    "unix": "scripts/ensure-speaker-transcribe.sh",
    "windows": "scripts/ensure-speaker-transcribe.ps1"
  },
  "bootstrap": {
    "preferred": "uv tool install \"speaker-transcribe[full]\"",
    "fallback": "pipx install \"speaker-transcribe[full]\""
  },
  "development": {
    "env_var": "SPEAKER_TRANSCRIBE_DEV_ROOT",
    "setup": "uv sync --extra dev --extra full"
  },
  "prerequisites": [
    "python>=3.10",
    "ffmpeg and ffprobe (OS-level)"
  ]
}
